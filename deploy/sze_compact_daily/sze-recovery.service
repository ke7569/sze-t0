[Unit]
Description=Fixed Shenzhen daily recovery launcher
After=sze-capture.service
Requires=sze-capture.service

[Service]
Type=simple
WorkingDirectory=/home/zane/run_main
ExecStart=/home/zane/bin/run_sze_recovery_launcher.sh
ExecStartPre=/home/zane/bin/sze_daily_preflight.sh
KillSignal=SIGTERM
TimeoutStopSec=120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
